<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher6.Cling xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher6"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    launcher:drawIdentifier="workspace_portrait">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/content"
        android:layout_width="859dp"
        android:layout_height="402dp"
        android:layout_marginTop="40dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/clingtitletext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/workspace_cling_title"
                style="@style/ClingTitleText"/>
            <TextView
                android:id="@+id/clingtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/workspace_cling_move_item"
                style="@style/ClingText"/>
        </LinearLayout>
    </FrameLayout>
    <Button
        android:layout_gravity="end|bottom"
        android:id="@+id/clickapp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/cling_dismiss"
        android:layout_marginEnd="90dp"
        style="@style/ClingButton"/>
    <Button
        android:layout_gravity="start|bottom"
        android:id="@+id/clickapp_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/cling_cancel"
        android:layout_marginStart="90dp"
        style="@style/ClingButton"/>
</com.android.launcher6.Cling>
