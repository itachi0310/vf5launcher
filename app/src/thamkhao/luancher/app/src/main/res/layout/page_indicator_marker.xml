<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher6.PageIndicatorMarker xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher6"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="0dp"
    android:layout_marginRight="0dp">
    <ImageView
        android:id="@+id/inactive"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/indicator_normalbar"
        android:scaleType="centerInside"/>
    <ImageView
        android:id="@+id/active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/indicator_lightbar"
        android:scaleType="centerInside"
        android:alpha="0"
        android:scaleX="1"
        android:scaleY="1"/>
</com.android.launcher6.PageIndicatorMarker>
