<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher6.Cling xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher6"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    launcher:drawIdentifier="workspace_portrait">
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="top"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cling"
                android:paddingLeft="20dp"
                android:paddingTop="20dp"
                android:paddingRight="20dp"
                android:paddingBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/workspace_cling_title"
                    style="@style/ClingTitleText"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/workspace_cling_move_item"
                    style="@style/ClingText"/>
            </LinearLayout>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/cling_arrow_down"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="bottom|left"
            android:orientation="vertical"
            android:id="@+id/focused_hotseat_app_bubble"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginBottom="90dp">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cling"
                android:paddingLeft="20dp"
                android:paddingTop="20dp"
                android:paddingRight="20dp"
                android:paddingBottom="20dp"
                android:layout_width="240dp"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/focused_hotseat_app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/ClingTitleText"/>
                <TextView
                    android:id="@+id/focused_hotseat_app_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ClingText"/>
            </LinearLayout>
            <ImageView
                android:layout_gravity="left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="78dp"
                android:src="@drawable/cling_arrow_down"/>
        </LinearLayout>
    </FrameLayout>
    <Button
        android:layout_gravity="bottom|right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="15dp"
        android:onClick="dismissWorkspaceCling"
        style="@style/ClingButton"/>
</com.android.launcher6.Cling>
