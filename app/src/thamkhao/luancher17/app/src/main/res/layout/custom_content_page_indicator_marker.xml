<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher17.PageIndicatorMarker xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher17"
    android:layout_gravity="center_vertical"
    android:layout_width="16dp"
    android:layout_height="16dp">
    <ImageView
        android:id="@+id/inactive"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/custom_content_page"
        android:scaleType="centerInside"/>
    <ImageView
        android:id="@+id/active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/custom_content_page"
        android:scaleType="centerInside"
        android:alpha="0"
        android:scaleX="0.5"
        android:scaleY="0.5"/>
</com.android.launcher17.PageIndicatorMarker>
