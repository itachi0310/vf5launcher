<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WallpaperCropper" parent="@android:style/Theme.Holo">
        <item name="android:windowFullscreen">true</item>
        <item name="android:actionBarStyle">@style/WallpaperCropperActionBar</item>
        <item name="android:windowActionBarOverlay">true</item>
    </style>
    <style name="WallpaperCropperActionBar" parent="@android:style/Widget.Holo.ActionBar">
        <item name="android:background">#88000000</item>
        <item name="android:displayOptions">0x10</item>
    </style>
    <style name="Theme" parent="@android:style/Theme.Holo.Wallpaper.NoTitleBar">
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>
    <style name="ClingButton" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">0x1</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:background">@drawable/cling_button_bg</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="android:layout_width">-2</item>
        <item name="android:layout_height">-2</item>
        <item name="android:text">@string/cling_dismiss</item>
        <item name="android:paddingStart">50dp</item>
        <item name="android:paddingEnd">50dp</item>
    </style>
    <style name="ClingTitleText" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:layout_width">-2</item>
        <item name="android:layout_height">-2</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>
    <style name="ClingAltTitleText" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">#49c0ec</item>
        <item name="android:layout_width">-2</item>
        <item name="android:layout_height">-2</item>
    </style>
    <style name="ClingText" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#80000000</item>
        <item name="android:layout_width">-2</item>
        <item name="android:layout_height">-2</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>
    <style name="ClingHintText" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#80ffffff</item>
        <item name="android:layout_width">-2</item>
        <item name="android:layout_height">-2</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>
    <style name="WorkspaceIcon" parent="">
        <item name="android:ellipsize">4</item>
        <item name="android:gravity">0x1</item>
        <item name="android:layout_gravity">0x11</item>
        <item name="android:layout_width">-2</item>
        <item name="android:layout_height">-2</item>
        <item name="android:singleLine">true</item>
        <item name="android:shadowRadius">2</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>
    <style name="WorkspaceIcon.Portrait" parent="@style/WorkspaceIcon">
    </style>
    <style name="WorkspaceIcon.Landscape" parent="@style/WorkspaceIcon">
    </style>
    <style name="WorkspaceIcon.AppsCustomize" parent="@style/WorkspaceIcon">
        <item name="android:background">@null</item>
        <item name="android:shadowColor">#ff000000</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:drawablePadding">4dp</item>
    </style>
    <style name="QSBBar" parent="">
        <item name="android:orientation">0</item>
    </style>
    <style name="SearchDropTargetBar" parent="">
    </style>
    <style name="SearchButton" parent="">
    </style>
    <style name="DropTargetButtonContainer" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">-1</item>
    </style>
    <style name="DropTargetButton" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#ffffffff</item>
        <item name="android:ellipsize">3</item>
        <item name="android:gravity">0x10</item>
        <item name="android:layout_gravity">0x11</item>
        <item name="android:layout_width">-2</item>
        <item name="android:layout_height">-1</item>
        <item name="android:singleLine">true</item>
        <item name="android:shadowColor">#ff000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:drawablePadding">7.5dp</item>
        <item name="android:paddingStart">25dp</item>
        <item name="android:paddingEnd">25dp</item>
    </style>
    <style name="TabIndicator" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">0x1</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:ellipsize">3</item>
        <item name="android:gravity">0x11</item>
        <item name="android:background">@drawable/tab_widget_indicator_selector</item>
        <item name="android:layout_width">-2</item>
        <item name="android:layout_height">-1</item>
        <item name="android:singleLine">true</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>
    <style name="TabIndicator.AppsCustomize" parent="@style/TabIndicator">
    </style>
    <style name="MarketButton" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/workspace_all_apps_and_delete_zone_text_color</item>
        <item name="android:shadowColor">@color/workspace_all_apps_and_delete_zone_text_shadow_color</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">2</item>
        <item name="android:paddingStart">5dp</item>
        <item name="android:paddingEnd">5dp</item>
    </style>
    <style name="CustomClingTitleText" parent="">
    </style>
    <style name="CustomClingText" parent="">
    </style>
    <style name="music_btn_style" parent="">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">49dp</item>
        <item name="android:onClick">onExtraClick</item>
    </style>
    <style name="hotseat_layout" parent="">
        <item name="android:gravity">0x11</item>
        <item name="android:layout_width">@dimen/hotseat_layout_width</item>
        <item name="android:layout_height">-1</item>
    </style>
    <style name="hotseat_textstyle" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:gravity">0x1</item>
        <item name="android:layout_width">-1</item>
        <item name="android:layout_height">-2</item>
    </style>
    <style name="translucent" parent="">
        <item name="android:windowBackground">@color/translucent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
    <style name="AppTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:typeface">2</item>
    </style>
</resources>
