<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher17"
    android:id="@+id/launcher"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.launcher17.DragLayer
        android:id="@+id/drag_layer"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.android.launcher17.Workspace
            android:layout_gravity="center"
            android:id="@+id/workspace"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            launcher:defaultScreen="@integer/config_workspaceDefaultScreen"
            launcher:pageSpacing="@dimen/workspace_page_spacing"/>
        <include
            android:layout_gravity="bottom"
            android:id="@+id/hotseat"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hotseat_btn_height"
            layout="@layout/m_hotseat"/>
        <include
            android:id="@+id/overview_panel"
            android:visibility="gone"
            layout="@layout/overview_panel"/>
        <include
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/page_indicator"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/page_indicator"/>
        <com.android.launcher17.ScrimView
            android:id="@+id/cling_scrim"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include
            android:id="@+id/first_run_cling"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/first_run_cling"/>
        <include
            android:id="@+id/workspace_cling"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/workspace_cling"/>
        <include
            android:id="@+id/folder_cling"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/folder_cling"/>
        <include
            android:id="@+id/apps_customize_pane"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="0dp"
            layout="@layout/apps_customize_pane"/>
        <include
            android:id="@+id/clickapp_cling"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/clickapp_cling"/>
    </com.android.launcher17.DragLayer>
</FrameLayout>
