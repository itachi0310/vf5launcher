<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:background="@drawable/radio_bg"
        android:layout_width="@dimen/x440"
        android:layout_height="@dimen/y134"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        android:layout_alignParentRight="true">
        <TextView
            android:textSize="26sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:id="@+id/tv_freq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/y37"
            android:layout_marginTop="@dimen/y15"
            android:text="87.50"
            android:singleLine="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:id="@+id/tv_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/y30"
            android:layout_marginBottom="5dp"
            android:text="KHZ"
            android:layout_toRightOf="@+id/tv_freq"
            android:layout_alignBottom="@+id/tv_freq"/>
        <Button
            android:id="@+id/radio_btn_prev"
            android:background="@drawable/btn_ic_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_freq"/>
        <Button
            android:id="@+id/radio_btn_next"
            android:background="@drawable/btn_ic_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/radio_btn_prev"
            android:layout_alignTop="@+id/radio_btn_prev"/>
    </RelativeLayout>
</RelativeLayout>
