<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher17.Folder xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher17"
    android:orientation="vertical"
    android:background="@drawable/portal_container_holo"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.android.launcher17.CellLayout
            android:id="@+id/folder_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:cacheColorHint="#ff333333"
            android:hapticFeedbackEnabled="false"/>
    </ScrollView>
    <com.android.launcher17.FolderEditText
        android:textSize="14sp"
        android:textColor="#ff777777"
        android:textColorHighlight="#ffcccccc"
        android:gravity="center_horizontal"
        android:id="@+id/folder_name"
        android:background="#00000000"
        android:paddingTop="@dimen/folder_name_padding"
        android:paddingBottom="@dimen/folder_name_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/folder_hint_text"
        android:singleLine="true"
        android:layout_centerHorizontal="true"
        android:imeOptions="flagNoExtractUi"
        android:textCursorDrawable="@null"
        android:fontFamily="sans-serif-condensed"/>
</com.android.launcher17.Folder>
