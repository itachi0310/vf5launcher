<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_left"
        android:background="@drawable/left_bg"
        android:layout_width="wrap_content"
        android:layout_height="519dp"
        android:layout_marginTop="60dp">
        <RelativeLayout
            android:layout_width="122dp"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/ll_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true">
                <com.fyt.widget.DigitClock
                    android:id="@+id/digit_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"/>
                <com.fyt.widget.Date
                    android:textSize="17sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_below="@+id/digit_clock"
                    android:layout_centerHorizontal="true"/>
                <com.fyt.widget.WeekDay
                    android:textSize="17sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/curWeek"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="周一"
                    android:layout_below="@+id/date"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <ImageView
                android:id="@+id/rl_settings"
                android:tag="@string/skin_ruleless"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="112dp"
                android:src="@drawable/car_settings_icon"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/rl_allapps"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="24dp"
                android:src="@drawable/all_apps_btn_icon"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_map_def"
        android:background="@drawable/ic_map_corner"
        android:layout_width="630dp"
        android:layout_height="361dp"
        android:layout_marginLeft="140dp"
        android:layout_marginTop="70dp"
        android:scaleType="fitXY"/>
    <RelativeLayout
        android:id="@+id/rl_music"
        android:background="@drawable/music_bg"
        android:layout_width="215dp"
        android:layout_height="362dp"
        android:layout_marginLeft="15dp"
        android:layout_toRightOf="@+id/iv_map_def"
        android:layout_alignTop="@+id/iv_map_def">
        <ImageView
            android:id="@+id/iv_album_bg"
            android:tag="@string/skin_ruleless"
            android:layout_width="215dp"
            android:layout_height="220dp"
            android:src="@drawable/music_album_def"
            android:scaleType="fitXY"/>
        <ProgressBar
            android:id="@+id/music_progress"
            android:tag="@string/skin_ruleless"
            android:layout_width="174dp"
            android:layout_height="6dp"
            android:layout_marginTop="184dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/progressbar_bg"
            android:thumbOffset="0dp"
            android:layout_centerHorizontal="true"
            android:paddingStart="0px"
            android:paddingEnd="0px"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:id="@+id/music_cur_time"
            android:tag="@string/skin_ruleless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="00:00:00"
            android:singleLine="true"
            android:layout_below="@+id/music_progress"
            android:layout_alignLeft="@+id/music_progress"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:id="@+id/music_total_time"
            android:tag="@string/skin_ruleless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="00:00:00"
            android:singleLine="true"
            android:layout_below="@+id/music_progress"
            android:layout_alignRight="@+id/music_progress"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/tv_musicName"
            android:layout_width="192dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:text="@string/music_name"
            android:singleLine="true"
            android:layout_below="@+id/music_progress"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/tv_artist"
            android:layout_width="192dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/music_author"
            android:singleLine="true"
            android:layout_below="@+id/tv_musicName"
            android:layout_centerHorizontal="true"/>
        <Button
            android:id="@+id/music_prev"
            android:background="@drawable/btn_ic_prev"
            android:layout_width="61dp"
            android:layout_height="61dp"
            android:layout_marginRight="10dp"
            android:layout_toLeftOf="@+id/music_playpause"
            android:layout_alignTop="@+id/music_playpause"/>
        <Button
            android:id="@+id/music_playpause"
            android:tag="@string/skin_ruleless"
            android:background="@drawable/music_pause_icon"
            android:layout_width="61dp"
            android:layout_height="61dp"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/tv_artist"
            android:layout_centerHorizontal="true"/>
        <Button
            android:id="@+id/music_next"
            android:background="@drawable/btn_ic_next"
            android:layout_width="61dp"
            android:layout_height="61dp"
            android:layout_alignTop="@+id/music_playpause"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/music_playpause"/>
    </RelativeLayout>
    <android.support.v7.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="872dp"
        android:layout_height="144dp"
        android:layout_marginLeft="132dp"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/rl_music"/>
</RelativeLayout>
