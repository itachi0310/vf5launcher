<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="60dp"
        android:layout_marginRight="60dp">
        <RelativeLayout
            android:id="@+id/m_navi_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="14dp"
            android:layout_alignParentRight="true">
            <ImageView
                android:id="@+id/ic_hotseat_navi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/car_navi_icon"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_color_white"
                android:id="@+id/tv_navi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/car_navi"
                android:singleLine="true"
                android:layout_alignBottom="@+id/ic_hotseat_navi"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/m_bt_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/ic_hotseat_bt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/car_bt_icon"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_color_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/car_bt"
                android:singleLine="true"
                android:layout_alignBottom="@+id/ic_hotseat_bt"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/m_radio_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/ic_hotseat_radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/car_radio_icon"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_color_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/car_radio"
                android:singleLine="true"
                android:layout_alignBottom="@+id/ic_hotseat_radio"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/m_allapp_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/ic_hotseat_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/all_apps_btn_icon"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_color_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/car_app"
                android:singleLine="true"
                android:layout_alignBottom="@+id/ic_hotseat_app"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/m_music_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/ic_hotseat_music"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/car_music_icon"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_color_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/car_music"
                android:singleLine="true"
                android:layout_alignBottom="@+id/ic_hotseat_music"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/m_video_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/ic_hotseat_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/car_video_icon"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_color_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/car_video"
                android:singleLine="true"
                android:layout_alignBottom="@+id/ic_hotseat_video"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/m_settings_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/ic_hotseat_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/car_settings_icon"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_color_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/car_settings"
                android:singleLine="true"
                android:layout_alignBottom="@+id/ic_hotseat_settings"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
