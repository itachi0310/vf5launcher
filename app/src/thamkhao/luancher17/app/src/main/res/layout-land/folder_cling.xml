<?xml version="1.0" encoding="utf-8"?>
<com.android.launcher17.Cling xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher17" launcher:drawIdentifier="folder_portrait">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cling"
                android:paddingLeft="20dp"
                android:paddingTop="20dp"
                android:paddingRight="20dp"
                android:paddingBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/folder_cling_title"
                    android:text="@string/folder_cling_title"
                    style="@style/ClingTitleText"/>
                <TextView
                    android:id="@+id/folder_cling_create_folder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/folder_cling_create_folder"
                    style="@style/ClingText"/>
            </LinearLayout>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/cling_arrow_down"/>
        </LinearLayout>
    </FrameLayout>
    <Button
        android:layout_gravity="end|bottom"
        android:id="@+id/cling_dismiss"
        android:layout_marginBottom="15dp"
        android:onClick="dismissFolderCling"
        android:layout_marginEnd="20dp"
        style="@style/ClingButton"/>
</com.android.launcher17.Cling>
