<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/dt_music_layout"
        android:background="@drawable/music_bg"
        android:layout_width="420dp"
        android:layout_height="310dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/music_album_def1"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="30dp"
            android:src="@drawable/music_album_def"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/text_color_black"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/music_name"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/car_music"
            android:singleLine="true"
            android:layout_below="@+id/music_album_def1"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/music_play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_below="@+id/music_name">
            <ImageView
                android:id="@+id/music_prev"
                android:layout_width="@dimen/DTbtnWidth"
                android:layout_height="@dimen/DTbtnHeight"
                android:src="@drawable/btn_ic_prev"/>
            <ImageView
                android:id="@+id/music_playpause"
                android:tag="@string/skin_ruleless"
                android:layout_width="@dimen/DTbtnWidth"
                android:layout_height="@dimen/DTbtnHeight"
                android:layout_marginLeft="20dp"
                android:src="@drawable/music_pause_icon"/>
            <ImageView
                android:id="@+id/music_next"
                android:layout_width="@dimen/DTbtnWidth"
                android:layout_height="@dimen/DTbtnHeight"
                android:layout_marginLeft="20dp"
                android:src="@drawable/btn_ic_next"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
