<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drag_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/dt_layout"
        android:layout_width="@dimen/x440"
        android:layout_height="@dimen/y155"
        android:layout_marginTop="10dp"
        android:layout_marginRight="40dp"
        android:layout_alignParentRight="true">
        <com.fyt.widget.DigitClock
            android:id="@+id/ll_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="@dimen/y25"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:id="@+id/dt_date1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="10dp"
            android:text="2015/06/09"
            android:layout_below="@+id/ll_time"
            android:layout_alignLeft="@+id/ll_time"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:id="@+id/dt_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="星期五"
            android:layout_below="@+id/ll_time"
            android:layout_alignRight="@+id/ll_time"/>
        <ImageView
            android:layout_width="103dp"
            android:layout_height="103dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/ic_flow_center"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/iv_flow_ring"
            android:layout_width="103dp"
            android:layout_height="103dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/ic_flow_ring"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:gravity="center_horizontal"
            android:id="@+id/tv_flow"
            android:layout_width="103dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:text="0.0MB"
            android:layout_below="@+id/iv_flow_ring"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/page_radio"
        android:background="@drawable/radio_bg"
        android:layout_width="@dimen/x440"
        android:layout_height="@dimen/y155"
        android:layout_marginTop="15dp"
        android:layout_marginRight="40dp"
        android:layout_below="@+id/dt_layout"
        android:layout_alignParentRight="true">
        <TextView
            android:textSize="26sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:id="@+id/tv_freq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/y37"
            android:layout_marginTop="@dimen/y25"
            android:text="87.50"
            android:singleLine="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:id="@+id/tv_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/y30"
            android:layout_marginBottom="5dp"
            android:text="KHZ"
            android:layout_toRightOf="@+id/tv_freq"
            android:layout_alignBottom="@+id/tv_freq"/>
        <Button
            android:id="@+id/radio_btn_prev"
            android:background="@drawable/btn_ic_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_freq"/>
        <Button
            android:id="@+id/radio_btn_next"
            android:background="@drawable/btn_ic_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/radio_btn_prev"
            android:layout_alignTop="@+id/radio_btn_prev"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/page_music"
        android:background="@drawable/radio_bg"
        android:layout_width="@dimen/x440"
        android:layout_height="@dimen/y155"
        android:layout_marginTop="15dp"
        android:layout_marginRight="40dp"
        android:layout_below="@+id/dt_layout"
        android:layout_alignParentRight="true">
        <TextView
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:id="@+id/tv_musicName"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="15dp"
            android:text="@string/music_name"
            android:singleLine="true"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#618fd3"
            android:ellipsize="end"
            android:id="@+id/tv_artist"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/music_name"
            android:singleLine="true"
            android:layout_below="@+id/tv_musicName"
            android:layout_alignLeft="@+id/tv_musicName"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_toRightOf="@+id/tv_artist"
            android:layout_below="@+id/tv_artist">
            <Button
                android:layout_gravity="left"
                android:id="@+id/music_prev"
                android:background="@drawable/music_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:onClick="onFunc"/>
            <Button
                android:id="@+id/music_playpause"
                android:background="@drawable/music_pause_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:onClick="onFunc"/>
            <Button
                android:id="@+id/music_next"
                android:background="@drawable/music_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:onClick="onFunc"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/iv_album_bg1"
            android:layout_width="115dp"
            android:layout_height="115dp"
            android:layout_marginRight="30dp"
            android:src="@drawable/music_ring"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/iv_album_bg"
            android:layout_width="109dp"
            android:layout_height="109dp"
            android:layout_marginRight="30dp"
            android:src="@drawable/music_album_def"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</RelativeLayout>
