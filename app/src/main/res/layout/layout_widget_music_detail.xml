<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp">

    <!-- 1. Ảnh Album Art ở giữa trên cùng (Hình vuông bo góc) giống Hình số 1 -->
    <ImageView
        android:id="@+id/iv_music_album"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:src="@android:drawable/ic_media_play"
        android:background="#222D42"
        android:padding="12dp"
        android:layout_marginBottom="6dp"
        android:contentDescription="Music Album Cover" />

    <!-- 2. Tên Bài Hát (Tiêu đề chính) -->
    <TextView
        android:id="@+id/tv_music_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chưa phát nhạc"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever" />

    <!-- 3. Tên Ca Sĩ (Muted text bên dưới) -->
    <TextView
        android:id="@+id/tv_music_artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kết nối Bluetooth/Media"
        android:textColor="#A0AABF"
        android:textSize="14sp"
        android:singleLine="true"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp" />

    <!-- 4. Thanh gạch ngang mỏng chia cụm nút bấm giống Hình số 1 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#25FFFFFF"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp" />

    <!-- 5. Cụm 3 nút điều khiển Media nằm ngang, căn giữa dưới đáy giống Hình số 1 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Nút Previous -->
        <ImageButton
            android:id="@+id/btn_music_prev"
            android:layout_width="80dp"
            android:layout_height="65dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous"
            android:scaleType="centerInside"
            android:contentDescription="Previous Track" />

        <!-- Nút Play / Pause -->
        <ImageButton
            android:id="@+id/btn_music_toggle"
            android:layout_width="98dp"
            android:layout_height="65dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_play"
            android:scaleType="centerInside"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:contentDescription="Play or Pause" />

        <!-- Nút Next -->
        <ImageButton
            android:id="@+id/btn_music_next"
            android:layout_width="80dp"
            android:layout_height="65dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_next"
            android:scaleType="centerInside"
            android:contentDescription="Next Track" />
    </LinearLayout>

</LinearLayout>