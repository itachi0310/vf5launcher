<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Phía bên TRÁI TRÊN: Dữ liệu thời tiết -->
    <LinearLayout
        android:id="@+id/weather_left_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/tv_weather_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="29°C"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/iv_weather_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_report_image"
                android:contentDescription="Weather Status Icon" />

            <TextView
                android:id="@+id/tv_weather_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhiều mây"
                android:textColor="#A0AABF"
                android:textSize="12sp"
                android:layout_marginLeft="6dp"
                android:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_weather_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang xác định..."
            android:textColor="#A0AABF"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:visibility="visible" />
    </LinearLayout>

    <!-- Phía bên PHẢI DƯỚI: Đồng hồ lớn tự động cập nhật + Ngày tháng -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:gravity="right">

        <!-- Đồng hồ điện tử tự cập nhật hệ thống (Giảm 10% size) -->
        <TextClock
            android:id="@+id/tc_weather_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:fontFamily="sans-serif-thin"
            android:textStyle="normal" />

        <!-- Ngày tháng hiển thị bên dưới (Định dạng: Thứ ngày/tháng/năm) -->
        <TextClock
            android:id="@+id/tc_weather_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE dd/MM/yyyy"
            android:format24Hour="EEEE dd/MM/yyyy"
            android:textColor="#A0AABF"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</RelativeLayout>