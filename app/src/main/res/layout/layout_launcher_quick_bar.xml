<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="4dp"
    android:paddingTop="8dp"
    android:paddingRight="4dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_widget_card"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:gravity="center"
        android:weightSum="3">

        <!-- Slot 1 -->
        <ImageView
            android:id="@+id/btn_quick_app_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:padding="10dp"
            android:src="@android:drawable/ic_input_add"
            app:tint="#77FFFFFF"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Quick App 1" />

        <View
            android:layout_width="20dp"
            android:layout_height="0.5dp"
            android:background="#22FFFFFF"
            android:layout_gravity="center" />

        <!-- Slot 2 -->
        <ImageView
            android:id="@+id/btn_quick_app_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:padding="10dp"
            android:src="@android:drawable/ic_input_add"
            app:tint="#77FFFFFF"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Quick App 2" />

        <View
            android:layout_width="20dp"
            android:layout_height="0.5dp"
            android:background="#22FFFFFF"
            android:layout_gravity="center" />

        <!-- Slot 3 -->
        <ImageView
            android:id="@+id/btn_quick_app_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:padding="10dp"
            android:src="@android:drawable/ic_input_add"
            app:tint="#77FFFFFF"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Quick App 3" />

    </LinearLayout>
</FrameLayout>